FROM python:3.12-slim

# Install system dependencies in one layer
RUN apt-get update && apt-get install -y \
    git \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Set working directory to match Kubernetes expectations
WORKDIR /app

# Create non-root user for security
RUN groupadd -r mcp && useradd -r -g mcp mcp

# Copy requirements first for better Docker layer caching
COPY requirements.txt .

# Install Python dependencies with better caching and no unnecessary packages
RUN pip install --no-cache-dir --upgrade pip wheel && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir fastmcp>=0.4.1 && \
    pip cache purge

# Install additional MCP server dependencies
RUN pip install --no-cache-dir \
    anthropic

# Copy source code
COPY src/ ./src/

# Create necessary directories and set ownership
RUN mkdir -p /app/data /app/logs && \
    chown -R mcp:mcp /app

# Switch to non-root user
USER mcp

# Set environment variables to match Kubernetes deployment
ENV PYTHONPATH=/app/src
ENV ENVIRONMENT=production
ENV MCP_TRANSPORT=sse
ENV PORT=8080
ENV HOST=0.0.0.0
ENV PYTHONUNBUFFERED=1

# Expose MCP server port
EXPOSE 8080

# Health check for MCP server - using HTTP endpoint for FastMCP
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Run the FastMCP server
CMD ["python3", "/app/src/fastmcp_server.py"] 