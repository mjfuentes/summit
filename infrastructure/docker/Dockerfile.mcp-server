FROM python:3.12-slim

# Install system dependencies in one layer
RUN apt-get update && apt-get install -y \
    git \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Set working directory for MCP server
WORKDIR /mcp-server

# Create non-root user for security
RUN groupadd -r mcp && useradd -r -g mcp mcp

# Copy requirements first for better Docker layer caching
COPY requirements.txt .

# Install Python dependencies with better caching and no unnecessary packages
RUN pip install --no-cache-dir --upgrade pip wheel && \
    pip install --no-cache-dir -r requirements.txt && \
    pip cache purge

# Install additional MCP server dependencies
RUN pip install --no-cache-dir \
    mcp \
    anthropic

# Copy source code
COPY src/ ./src/

# Create necessary directories and set ownership
RUN mkdir -p /mcp-server/data /mcp-server/logs && \
    chown -R mcp:mcp /mcp-server

# Switch to non-root user
USER mcp

# Set environment variables
ENV PYTHONPATH=/mcp-server/src
ENV ENVIRONMENT=production
ENV MCP_SERVER_PORT=8080
ENV MCP_SERVER_HOST=0.0.0.0
ENV PYTHONUNBUFFERED=1

# Expose MCP server port
EXPOSE 8080

# Health check for MCP server (TCP check since it's not HTTP)
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
    CMD timeout 5 bash -c '</dev/tcp/localhost/8080' || exit 1

# Run the MCP server
CMD ["python", "src/summit.py"] 