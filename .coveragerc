[run]
source = src
omit = 
    */tests/*
    */test_*
    */__pycache__/*
    */venv/*
    */env/*
    setup.py

[report]
# Show missing lines in coverage report
show_missing = true

# Exclude lines from coverage
exclude_lines =
    pragma: no cover
    def __repr__
    if self.debug:
    if settings.DEBUG
    raise AssertionError
    raise NotImplementedError
    if 0:
    if __name__ == .__main__.:
    class .*\bProtocol\):
    @(abc\.)?abstractmethod

# Set precision for coverage percentage
precision = 2

# Skip covered files in report
skip_covered = false

# Skip empty files
skip_empty = true

[html]
directory = htmlcov

[xml]
output = coverage.xml 