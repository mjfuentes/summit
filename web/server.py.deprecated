@app.post("/api/soundcloud/search", response_model=ApiResponse)
async def search_soundcloud(request: SoundCloudSearchRequest):
    """Search for tracks on SoundCloud"""
    try:
        result = await handle_call_tool(
            "soundcloud_search", {"query": request.query, "limit": request.limit}
        )
        return ApiResponse(success=True, data=result[0].text)
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


@app.get("/api/soundcloud/stream/{track_id}")
async def stream_soundcloud_track(track_id: str):
    """Get a streamable URL for a SoundCloud track"""
    try:
        result = await handle_call_tool(
            "soundcloud_get_stream_url", {"track_id": track_id}
        )
        # Extract the URL from the response
        stream_url = None
        for line in result[0].text.split("\n"):
            if line.startswith("Stream URL: "):
                stream_url = line.replace("Stream URL: ", "").strip()
                break

        if not stream_url:
            raise ValueError("Could not extract stream URL from response")

        # Return JSON with the URL instead of redirecting
        return {"success": True, "data": {"stream_url": stream_url}}
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


@app.get("/health")
async def health_check():
    """Simple health check endpoint"""
    return {"status": "healthy"}


# Mount static files for the web UI
app.mount("/static", StaticFiles(directory="web/static"), name="static")


def start_server():
    """Start the FastAPI server"""
    uvicorn.run(
        "web.server:app",
        host="0.0.0.0",
        port=int(os.getenv("PORT", "8000")),
        reload=True,
    )


if __name__ == "__main__":
    start_server()
