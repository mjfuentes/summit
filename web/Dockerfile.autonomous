FROM ubuntu:22.04

# Set environment variables to avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive
ENV NODE_VERSION=18

# Set Anthropic API key directly in the image
ENV ANTHROPIC_API_KEY=***REMOVED***

# Install system dependencies in optimized layers
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    git \
    build-essential \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 18 from NodeSource repository (more reliable than default packages)
RUN curl -fsSL https://deb.nodesource.com/setup_18.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install Python 3 and pip
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Install additional development tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    vim \
    nano \
    htop \
    tree \
    unzip \
    ripgrep \
    && rm -rf /var/lib/apt/lists/*

# Create workspace early to improve Docker layer caching
WORKDIR /workspace

# Install Claude Code (the official Anthropic CLI tool)
RUN npm install -g @anthropic-ai/claude-code --unsafe-perm=true --allow-root

# Install web-based terminal for browser access (from official source)
RUN wget -O /usr/local/bin/ttyd https://github.com/tsl0922/ttyd/releases/download/1.7.3/ttyd.x86_64 \
    && chmod +x /usr/local/bin/ttyd

# Install core Python development tools (minimal set first)
RUN pip3 install --no-cache-dir \
    anthropic \
    requests \
    fastapi \
    uvicorn \
    pytest

# Install additional Python packages in separate layer for better caching
RUN pip3 install --no-cache-dir \
    black \
    flake8 \
    mypy \
    jupyter \
    numpy \
    pandas

# Install web frameworks and databases
RUN pip3 install --no-cache-dir \
    django \
    flask \
    sqlalchemy \
    matplotlib \
    seaborn \
    scikit-learn

# Install additional Node.js development tools
RUN npm install -g --unsafe-perm=true --allow-root \
    typescript \
    ts-node \
    eslint \
    prettier

# Install major frontend frameworks (these are large, so install separately)
RUN npm install -g --unsafe-perm=true --allow-root \
    @angular/cli \
    @vue/cli \
    create-react-app

# Setup git configuration
RUN git config --global user.name "Summit AI" && \
    git config --global user.email "summit@ai.dev" && \
    git config --global init.defaultBranch main

# Create a non-root user for Claude Code (security requirement)
RUN useradd -m -s /bin/bash claude && \
    chown -R claude:claude /workspace

# Copy task startup script
COPY claude_code_task.sh /workspace/claude_code_task.sh
RUN chmod +x /workspace/claude_code_task.sh && \
    chown claude:claude /workspace/claude_code_task.sh

# Expose ports for web terminal and potential services
EXPOSE 7681 8080 3000 8000

# Switch to non-root user
USER claude

# Set the entrypoint
ENTRYPOINT ["/workspace/claude_code_task.sh"] 