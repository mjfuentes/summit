FROM ubuntu:22.04

# Set environment variables to avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive
ENV NODE_VERSION=18

# Set Anthropic API key directly in the image
ENV ANTHROPIC_API_KEY=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

# Install system dependencies in optimized layers
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    git \
    build-essential \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 18 from NodeSource repository (more reliable than default packages)
RUN curl -fsSL https://deb.nodesource.com/setup_18.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install Python 3 and pip
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Install additional development tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    vim \
    nano \
    htop \
    tree \
    unzip \
    ripgrep \
    && rm -rf /var/lib/apt/lists/*

# Create workspace early to improve Docker layer caching
WORKDIR /workspace

# Copy requirements file and install dependencies in a single layer
COPY requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt

# Install Claude Code (the official Anthropic CLI tool)
RUN npm install -g @anthropic-ai/claude-code --unsafe-perm=true --allow-root

# Install web-based terminal for browser access (from official source)
RUN wget -O /usr/local/bin/ttyd https://github.com/tsl0922/ttyd/releases/download/1.7.3/ttyd.x86_64 \
    && chmod +x /usr/local/bin/ttyd

# Create a non-root user for Claude Code (security requirement)
RUN useradd -m -s /bin/bash claude \
    && chown -R claude:claude /workspace

# Copy task script if it exists (optional for testing)
COPY claude_code_task.sh* /workspace/
RUN if [ -f "/workspace/claude_code_task.sh" ]; then chmod +x /workspace/claude_code_task.sh; fi

# Expose ports for web terminal and potential services
EXPOSE 7681 8080 3000 8000

# Switch to non-root user
USER claude

# Set the entrypoint
ENTRYPOINT ["/workspace/claude_code_task.sh"] 