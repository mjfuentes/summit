FROM ubuntu:22.04

# Set environment variables to avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive
ENV NODE_VERSION=18

# API key will be provided at runtime via docker run -e
# ENV ANTHROPIC_API_KEY will be set by the container runner

# Install system dependencies in optimized layers
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    git \
    build-essential \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 18 from NodeSource repository (more reliable than default packages)
RUN curl -fsSL https://deb.nodesource.com/setup_18.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install Python 3 and pip
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Install additional development tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    vim \
    nano \
    htop \
    tree \
    unzip \
    ripgrep \
    && rm -rf /var/lib/apt/lists/*

# Create workspace early to improve Docker layer caching
WORKDIR /workspace

# Copy requirements file and install dependencies in a single layer
COPY requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt

# Install OpenCode (the open-source AI coding assistant)
RUN curl -fsSL https://raw.githubusercontent.com/opencode-ai/opencode/main/install | bash

# Install web-based terminal for browser access (from official source)
RUN wget -O /usr/local/bin/ttyd https://github.com/tsl0922/ttyd/releases/download/1.7.3/ttyd.x86_64 \
    && chmod +x /usr/local/bin/ttyd

# Create a non-root user for OpenCode (security requirement)
RUN useradd -m -s /bin/bash claude \
    && chown -R claude:claude /workspace

# Copy task script if it exists (optional for testing)
COPY opencode_task.sh* /workspace/
RUN if [ -f "/workspace/opencode_task.sh" ]; then chmod +x /workspace/opencode_task.sh; fi

# Expose ports for web terminal and potential services
EXPOSE 7681 8080 3000 8000

# Switch to non-root user
USER claude

# Set the entrypoint
ENTRYPOINT ["/workspace/opencode_task.sh"] 