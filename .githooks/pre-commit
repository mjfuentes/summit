#!/bin/bash

# Summit AI Pre-Commit Hook
# Automatically enforces code quality standards including emoji removal and formatting

set -e

echo "Running Summit AI pre-commit checks..."

# Change to repository root
cd "$(git rev-parse --show-toplevel)"

# Check if Python is available
if ! command -v python &> /dev/null; then
    echo "Error: python not found. Please ensure Python is in your PATH."
    exit 1
fi

# Check if we're in an auto-fix loop (prevent infinite recursion)
AUTO_FIX_FLAG=".git/AUTO_FIX_IN_PROGRESS"
ORIGINAL_MSG_FILE=".git/ORIGINAL_COMMIT_MSG"
STAGED_FILES_LIST=".git/STAGED_FILES_BACKUP"

if [ -f "$AUTO_FIX_FLAG" ]; then
    echo "  -> Auto-fix cycle detected, running verification on fixed code..."
    rm -f "$AUTO_FIX_FLAG"
    rm -f "$ORIGINAL_MSG_FILE"
    rm -f "$STAGED_FILES_LIST"
    # Continue with verification checks below
else
    # Track if any files were auto-fixed
    FILES_MODIFIED=false
    
    # Capture list of originally staged files
    git diff --cached --name-only --diff-filter=ACM > "$STAGED_FILES_LIST"

    # Capture original commit message before any modifications
    COMMIT_MSG_FILE=".git/COMMIT_EDITMSG"
    if [ -f "$COMMIT_MSG_FILE" ]; then
        cp "$COMMIT_MSG_FILE" "$ORIGINAL_MSG_FILE"
    fi

    # Make sure emoji linter is executable
    chmod +x tools/emoji_linter.py

    # 1. Run emoji linter on staged files
    echo "Checking for emoji violations..."
    echo "  -> Scanning staged files for emojis..."
    if python tools/emoji_linter.py --staged --fix; then
        echo "  -> Emoji check passed"
    else
        echo "  -> Emoji violations found and fixed"
        FILES_MODIFIED=true
    fi

    # 2. Auto-format Python code with Black
    PYTHON_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)
    if [ ! -z "$PYTHON_FILES" ]; then
        echo "Auto-formatting Python code with Black..."
        file_count=$(echo "$PYTHON_FILES" | wc -l | tr -d ' ')
        echo "  -> Found $file_count Python files to format"
        
        # Check if black is available
        if python -c "import black" 2>/dev/null; then
            echo "  -> Running Black formatter..."
            python -m black $PYTHON_FILES --line-length 79 --quiet
            
            # Check if any files were modified
            if ! git diff --quiet $PYTHON_FILES; then
                echo "  -> Code was auto-formatted"
                FILES_MODIFIED=true
            else
                echo "  -> Black formatting check passed"
            fi
        else
            echo "  -> Black not available, skipping auto-formatting"
        fi
        
        # 3. Sort imports with isort
        if python -c "import isort" 2>/dev/null; then
            echo "  -> Running isort for import sorting..."
            python -m isort $PYTHON_FILES --profile black --line-length 79 --quiet
            
            # Check if any files were modified
            if ! git diff --quiet $PYTHON_FILES; then
                echo "  -> Imports were auto-sorted"
                FILES_MODIFIED=true
            else
                echo "  -> Import sorting check passed"
            fi
        else
            echo "  -> isort not available, skipping import sorting"
        fi
    fi

    # If files were modified, auto-add them and re-commit with verification
    if [ "$FILES_MODIFIED" = true ]; then
        echo ""
        echo "  -> Auto-fixes applied. Re-staging ONLY originally staged files..."
        
        # Create flag to prevent infinite recursion
        touch "$AUTO_FIX_FLAG"
        
        # Re-add ONLY the files that were originally staged
        echo "  -> Re-staging these originally staged files:"
        while IFS= read -r file; do
            if [ -f "$file" ]; then
                echo "    - $file"
                git add "$file"
            fi
        done < "$STAGED_FILES_LIST"
        
        # Get the original commit message
        ORIGINAL_MSG=""
        if [ -f "$ORIGINAL_MSG_FILE" ]; then
            ORIGINAL_MSG=$(cat "$ORIGINAL_MSG_FILE")
        elif [ -f "$COMMIT_MSG_FILE" ]; then
            ORIGINAL_MSG=$(cat "$COMMIT_MSG_FILE")
        else
            ORIGINAL_MSG="Auto-fixed formatting and imports"
        fi
        
        echo "  -> Re-executing commit with message: \"$ORIGINAL_MSG\""
        echo "  -> Will run full verification on auto-fixed code..."
        
        # Re-run the commit with the original message and allow pre-commit hook to verify
        # Use git commit without exec to avoid HEAD reference issues
        git commit -m "$ORIGINAL_MSG"
        exit 0
    fi
fi

# 4. Run tests (if pytest is available and we have tests)
if command -v python &> /dev/null && [ -d "tests" ]; then
    echo "Running tests in parallel..."
    if python -c "import pytest" 2>/dev/null; then
        echo "  -> Detected $(python -c "import os; print(os.cpu_count())") CPU cores"
        echo "  -> Starting parallel test execution..."
        start_time=$(date +%s)
        
        # Try to use parallel execution (excluding slow and CI-only tests)
        if python -c "import pytest_xdist" 2>/dev/null; then
            echo "  -> Using pytest-xdist for parallel execution"
            if ! python -m pytest tests/ -n auto --tb=short -q -m "not autonomous and not slow and not ci_only"; then
                echo "Tests failed. Commit aborted."
                exit 1
            fi
        elif which pytest-xdist 2>/dev/null || pip show pytest-xdist >/dev/null 2>&1; then
            echo "  -> Found pytest-xdist, using parallel execution"
            if ! python -m pytest tests/ -n auto --tb=short -q -m "not autonomous and not slow and not ci_only"; then
                echo "Tests failed. Commit aborted."
                exit 1
            fi
        else
            echo "  -> pytest-xdist not available, running sequentially"
            if ! python -m pytest tests/ --tb=short -q -m "not autonomous and not slow and not ci_only"; then
                echo "Tests failed. Commit aborted."
                exit 1
            fi
        fi
        
        end_time=$(date +%s)
        duration=$((end_time - start_time))
        echo "  -> Tests completed in ${duration}s"
        echo "Tests passed"
    else
        echo "pytest not available, skipping tests"
    fi
fi

# 4.1. Run browser terminal tests (if Selenium is available)
if command -v python &> /dev/null && [ -f "tests/test_browser_terminal.py" ]; then
    echo "Running browser terminal tests..."
    if python -c "import selenium" 2>/dev/null; then
        echo "  -> Selenium detected, running browser terminal validation..."
        start_time=$(date +%s)
        
        # Run only the critical browser error detection test (without coverage)
        if ! python -m pytest tests/test_browser_terminal.py::TestBrowserTerminal::test_browser_loads_without_errors --tb=short -q --no-cov; then
            echo "  -> Browser terminal test failed. Web interface has JavaScript errors."
            echo "  -> This indicates the browser terminal will not work correctly."
            echo "  -> Please fix JavaScript errors before committing."
            exit 1
        fi
        
        end_time=$(date +%s)
        duration=$((end_time - start_time))
        echo "  -> Browser terminal test completed in ${duration}s"
        echo "  -> Browser terminal validation passed"
    else
        echo "  -> Selenium not available, skipping browser terminal tests"
        echo "  -> Install selenium>=4.15.0 to enable browser terminal validation"
    fi
fi

# 5. Check Python syntax (if we have Python files)
PYTHON_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)
if [ ! -z "$PYTHON_FILES" ]; then
    echo "Checking Python syntax..."
    file_count=$(echo "$PYTHON_FILES" | wc -l | tr -d ' ')
    echo "  -> Found $file_count Python files to check"
    for file in $PYTHON_FILES; do
        if [ -f "$file" ]; then
            echo "  -> Checking $file"
            if ! python -m py_compile "$file"; then
                echo "  -> Python syntax error in $file"
                exit 1
            fi
        fi
    done
    echo "  -> Python syntax check passed"
fi

# 6. Check for debugging statements and common issues
echo "Checking for debugging statements..."
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
staged_count=$(echo "$STAGED_FILES" | wc -l | tr -d ' ')
echo "  -> Scanning $staged_count staged files"
for file in $STAGED_FILES; do
    if [ -f "$file" ] && [[ "$file" != *"pre-commit"* ]]; then
        # Check for debugging statements (skip pre-commit hooks)
        if grep -n "import pdb\|pdb.set_trace()\|breakpoint()\|console.log\|debugger;" "$file" > /dev/null; then
            echo "  -> Warning: Debugging statements found in $file"
            grep -n "import pdb\|pdb.set_trace()\|breakpoint()\|console.log\|debugger;" "$file"
            echo "  -> Remove debugging statements before committing."
            exit 1
        fi
        
        # Check for TODO/FIXME without issue numbers
        if grep -n "TODO\|FIXME" "$file" | grep -v "#[0-9]" > /dev/null; then
            echo "  -> Warning: TODO/FIXME found without issue number in $file"
            echo "  -> Please link TODOs to GitHub issues: # TODO #123: description"
        fi
    fi
done
echo "  -> Debugging statement check passed"

# 7. Ensure no emojis in commit message
echo "Checking commit message..."
COMMIT_MSG_FILE=".git/COMMIT_EDITMSG"
if [ -f "$COMMIT_MSG_FILE" ]; then
    echo "  -> Scanning commit message for emojis..."
    if ! python tools/emoji_linter.py "$COMMIT_MSG_FILE" > /dev/null 2>&1; then
        echo "  -> Commit message contains emojis. Please use professional language only."
        exit 1
    fi
    echo "  -> Commit message check passed"
fi

# 8. Prevent deletion of test files
echo "Checking for test file deletions..."
DELETED_TEST_FILES=$(git diff --cached --name-only --diff-filter=D | grep -E '^tests/.*\.py$|test_.*\.py$|.*_test\.py$' || true)
if [ ! -z "$DELETED_TEST_FILES" ]; then
    echo "  -> ERROR: Test file deletion detected!"
    echo "  -> The following test files are being deleted:"
    echo "$DELETED_TEST_FILES" | sed 's/^/    /'
    echo ""
    echo "  -> Test files should NEVER be deleted as they provide critical validation."
    echo "  -> If you need to modify tests, edit them instead of deleting them."
    echo "  -> If a test is truly obsolete, move it to tests/archived/ for review."
    echo ""
    echo "To undo the deletion, run:"
    echo "  git reset HEAD -- $DELETED_TEST_FILES"
    echo "  git checkout -- $DELETED_TEST_FILES"
    exit 1
fi
echo "  -> Test file deletion check passed"

echo ""
echo " All pre-commit checks passed!"
echo "" 