# Database configuration for Summit AI - Unified PostgreSQL System
# All components (web app, agents, tasks) use the same PostgreSQL database

# Database URL - PostgreSQL for production, SQLite for development
# For production with PostgreSQL:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost/summit_unified

# For development with SQLite (fallback):
# DATABASE_URL=sqlite+aiosqlite:///data/summit_unified.db

# Database connection pool settings (for PostgreSQL)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Task retention settings
TASK_RETENTION_DAYS=90
MAX_COMPLETED_TASKS_IN_MEMORY=50

# Database maintenance settings
AUTO_CLEANUP_ENABLED=true
CLEANUP_INTERVAL_HOURS=24

# Agent system settings
MAX_CONCURRENT_AGENTS=20
AGENT_HEARTBEAT_INTERVAL=60