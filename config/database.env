# Database configuration for Summit AI
# SQLite database settings

# Database URL - defaults to SQLite in data/ directory
# For production, you might want to use PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/summit_tasks
DATABASE_URL=sqlite+aiosqlite:///data/tasks.db

# Database connection pool settings (for PostgreSQL)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30

# Task retention settings
TASK_RETENTION_DAYS=90
MAX_COMPLETED_TASKS_IN_MEMORY=50

# Database maintenance settings
AUTO_CLEANUP_ENABLED=true
CLEANUP_INTERVAL_HOURS=24