# Summit AI Production Environment Configuration
# This file contains production-specific settings
# Sensitive values should be set via CI/CD secrets or external secret management

# Application Configuration
SUMMIT_ENV=production
SUMMIT_LOG_LEVEL=info
SUMMIT_DEBUG=false
SUMMIT_READONLY_MODE=false

# API and Service URLs
SUMMIT_BASE_URL=https://summit.ai
SUMMIT_API_URL=https://api.summit.ai
SUMMIT_WEB_URL=https://app.summit.ai

# Security Settings
SUMMIT_ALLOWED_HOSTS=summit.ai,api.summit.ai,app.summit.ai
SUMMIT_CORS_ORIGINS=https://summit.ai,https://app.summit.ai
SUMMIT_SESSION_SECURE=true
SUMMIT_CSRF_PROTECTION=true

# Database Configuration (PostgreSQL)
POSTGRES_DB=summit
POSTGRES_USER=summit
# POSTGRES_PASSWORD should be set via secrets
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SSL_MODE=require

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=""
REDIS_SSL=false

# Monitoring and Logging
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_URL=https://monitoring.summit.ai
LOKI_URL=http://loki:3100
GRAFANA_ADMIN_USER=admin
# GRAFANA_PASSWORD should be set via secrets

# Docker Registry
REGISTRY=ghcr.io/mjfuentes/summit
IMAGE_TAG=latest

# Performance Tuning
SUMMIT_WORKER_PROCESSES=4
SUMMIT_MAX_CONNECTIONS=1000
SUMMIT_TIMEOUT=30
SUMMIT_KEEPALIVE=2

# Rate Limiting
SUMMIT_RATE_LIMIT_REQUESTS=1000
SUMMIT_RATE_LIMIT_WINDOW=3600

# Autonomous System Settings
SUMMIT_MAX_CONCURRENT_TASKS=10
SUMMIT_TASK_TIMEOUT_MINUTES=15
SUMMIT_DOCKER_RESOURCE_LIMIT_CPU=2
SUMMIT_DOCKER_RESOURCE_LIMIT_MEMORY=4g

# PR Template for AI Agent (placeholders only)
PR_TEMPLATE="# {title}

**Branch**: {branch}
**Commit**: {commit_sha}
**Created**: {timestamp}

## Summary
{summary}

## Changes
{changes}

## Files Modified
{files_modified}

## Quality Assurance
{quality_assurance}

## Review Process
{review_process}"

# Cost Controls
SUMMIT_DAILY_BUDGET=50.00
SUMMIT_HOURLY_BUDGET=5.00
SUMMIT_MAX_RECURSION_DEPTH=3

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_LOCATION=/backups

# SSL/TLS Configuration
SSL_ENABLED=true
SSL_CERT_PATH=/certs/summit.crt
SSL_KEY_PATH=/certs/summit.key
SSL_DHPARAM_PATH=/certs/dhparam.pem

# Load Balancer Configuration
LB_ALGORITHM=round_robin
LB_HEALTH_CHECK_PATH=/health
LB_HEALTH_CHECK_INTERVAL=10

# Observability
TRACING_ENABLED=true
METRICS_ENABLED=true
LOGGING_FORMAT=json
LOG_RETENTION_DAYS=90

# Feature Flags
FEATURE_AUTONOMOUS_TASKS=true
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_REAL_TIME_MONITORING=true
FEATURE_AUTO_SCALING=false

# External Service Integrations
SENTRY_DSN=""
DATADOG_API_KEY=""
NEW_RELIC_LICENSE_KEY=""

# Notification Settings
SLACK_WEBHOOK_URL=""
DISCORD_WEBHOOK_URL=""
EMAIL_SMTP_HOST=""
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASSWORD=""

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="Summit AI is currently undergoing maintenance. Please check back soon." 