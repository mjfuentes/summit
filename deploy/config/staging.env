# Summit AI Staging Environment Configuration
# This file contains staging-specific settings for pre-production testing

# Application Configuration
SUMMIT_ENV=staging
SUMMIT_LOG_LEVEL=info
SUMMIT_DEBUG=false
SUMMIT_READONLY_MODE=false

# API and Service URLs (Staging)
SUMMIT_BASE_URL=https://staging.summit.ai
SUMMIT_API_URL=https://api.staging.summit.ai
SUMMIT_WEB_URL=https://app.staging.summit.ai

# Security Settings (Production-like but relaxed for testing)
SUMMIT_ALLOWED_HOSTS=staging.summit.ai,api.staging.summit.ai,app.staging.summit.ai
SUMMIT_CORS_ORIGINS=https://staging.summit.ai,https://app.staging.summit.ai
SUMMIT_SESSION_SECURE=true
SUMMIT_CSRF_PROTECTION=true

# Database Configuration (PostgreSQL)
POSTGRES_DB=summit_staging
POSTGRES_USER=summit_staging
POSTGRES_PASSWORD=staging_password_secure_123
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SSL_MODE=prefer

# Redis Configuration
REDIS_URL=redis://redis:6379/1
REDIS_PASSWORD=""
REDIS_SSL=false

# Monitoring and Logging (Full stack for testing)
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_URL=https://monitoring.staging.summit.ai
LOKI_URL=http://loki:3100
GRAFANA_ADMIN_USER=admin
GRAFANA_PASSWORD=staging_admin_123

# Docker Registry
REGISTRY=ghcr.io/mjfuentes/summit
IMAGE_TAG=staging

# Performance Tuning (Moderate resources)
SUMMIT_WORKER_PROCESSES=2
SUMMIT_MAX_CONNECTIONS=500
SUMMIT_TIMEOUT=30
SUMMIT_KEEPALIVE=2

# Rate Limiting (Moderate for testing)
SUMMIT_RATE_LIMIT_REQUESTS=5000
SUMMIT_RATE_LIMIT_WINDOW=3600

# Autonomous System Settings (Limited for staging)
SUMMIT_MAX_CONCURRENT_TASKS=5
SUMMIT_TASK_TIMEOUT_MINUTES=10
SUMMIT_DOCKER_RESOURCE_LIMIT_CPU=1.5
SUMMIT_DOCKER_RESOURCE_LIMIT_MEMORY=3g

# Cost Controls (Moderate limits for staging)
SUMMIT_DAILY_BUDGET=20.00
SUMMIT_HOURLY_BUDGET=3.00
SUMMIT_MAX_RECURSION_DEPTH=3

# Health Check Configuration
HEALTH_CHECK_INTERVAL=20
HEALTH_CHECK_TIMEOUT=8
HEALTH_CHECK_RETRIES=3

# Backup Configuration (Enabled but with shorter retention)
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 3 * * *"  # Daily at 3 AM
BACKUP_RETENTION_DAYS=14
BACKUP_LOCATION=/staging-backups

# SSL/TLS Configuration (Enabled with staging certificates)
SSL_ENABLED=true
SSL_CERT_PATH=/certs/staging.summit.crt
SSL_KEY_PATH=/certs/staging.summit.key
SSL_DHPARAM_PATH=/certs/dhparam.pem

# Load Balancer Configuration
LB_ALGORITHM=round_robin
LB_HEALTH_CHECK_PATH=/health
LB_HEALTH_CHECK_INTERVAL=15

# Observability (Full observability for testing)
TRACING_ENABLED=true
METRICS_ENABLED=true
LOGGING_FORMAT=json
LOG_RETENTION_DAYS=30

# Feature Flags (Test all features)
FEATURE_AUTONOMOUS_TASKS=true
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_REAL_TIME_MONITORING=true
FEATURE_AUTO_SCALING=true

# External Service Integrations (Test integrations)
SENTRY_DSN="https://test@sentry.io/staging"
DATADOG_API_KEY=""
NEW_RELIC_LICENSE_KEY=""

# Notification Settings (Staging notifications)
SLACK_WEBHOOK_URL="https://hooks.slack.com/staging-webhook"
DISCORD_WEBHOOK_URL=""
EMAIL_SMTP_HOST="smtp.staging.summit.ai"
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER="noreply@staging.summit.ai"
EMAIL_SMTP_PASSWORD=""

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="Staging environment - for testing purposes only"

# Staging-specific Settings
STAGING_DATA_RESET_SCHEDULE="0 6 * * 1"  # Reset test data weekly
STAGING_PERFORMANCE_TESTING=true
STAGING_LOAD_TEST_USERS=100
STAGING_MOCK_EXTERNAL_APIS=true 