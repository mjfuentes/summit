# Summit AI Development Environment Configuration
# This file contains development-specific settings for local development

# Application Configuration
SUMMIT_ENV=development
SUMMIT_LOG_LEVEL=debug
SUMMIT_DEBUG=true
SUMMIT_READONLY_MODE=false

# API and Service URLs (Local)
SUMMIT_BASE_URL=http://localhost:8000
SUMMIT_API_URL=http://localhost:8000/api
SUMMIT_WEB_URL=http://localhost:8000

# Security Settings (Relaxed for development)
SUMMIT_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
SUMMIT_CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000
SUMMIT_SESSION_SECURE=false
SUMMIT_CSRF_PROTECTION=false

# Database Configuration (SQLite for development)
POSTGRES_DB=summit_dev
POSTGRES_USER=summit_dev
POSTGRES_PASSWORD=dev_password_123
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSL_MODE=disable

# Redis Configuration (Optional for development)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=""
REDIS_SSL=false

# Monitoring and Logging (Local)
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000
LOKI_URL=http://localhost:3100
GRAFANA_ADMIN_USER=admin
GRAFANA_PASSWORD=admin

# Docker Registry (Local builds)
REGISTRY=summit-local
IMAGE_TAG=dev

# Performance Tuning (Optimized for development)
SUMMIT_WORKER_PROCESSES=1
SUMMIT_MAX_CONNECTIONS=100
SUMMIT_TIMEOUT=60
SUMMIT_KEEPALIVE=1

# Rate Limiting (Relaxed for development)
SUMMIT_RATE_LIMIT_REQUESTS=10000
SUMMIT_RATE_LIMIT_WINDOW=3600

# Autonomous System Settings (Limited for development)
SUMMIT_MAX_CONCURRENT_TASKS=2
SUMMIT_TASK_TIMEOUT_MINUTES=5
SUMMIT_DOCKER_RESOURCE_LIMIT_CPU=1
SUMMIT_DOCKER_RESOURCE_LIMIT_MEMORY=2g

# Cost Controls (Lower limits for development)
SUMMIT_DAILY_BUDGET=5.00
SUMMIT_HOURLY_BUDGET=1.00
SUMMIT_MAX_RECURSION_DEPTH=2

# Health Check Configuration
HEALTH_CHECK_INTERVAL=10
HEALTH_CHECK_TIMEOUT=5
HEALTH_CHECK_RETRIES=2

# Backup Configuration (Disabled for development)
BACKUP_ENABLED=false
BACKUP_SCHEDULE=""
BACKUP_RETENTION_DAYS=7
BACKUP_LOCATION=./backups

# SSL/TLS Configuration (Disabled for development)
SSL_ENABLED=false
SSL_CERT_PATH=""
SSL_KEY_PATH=""
SSL_DHPARAM_PATH=""

# Load Balancer Configuration (Not needed for development)
LB_ALGORITHM=round_robin
LB_HEALTH_CHECK_PATH=/health
LB_HEALTH_CHECK_INTERVAL=30

# Observability (Enhanced for debugging)
TRACING_ENABLED=true
METRICS_ENABLED=true
LOGGING_FORMAT=pretty
LOG_RETENTION_DAYS=7

# Feature Flags (All enabled for testing)
FEATURE_AUTONOMOUS_TASKS=true
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_REAL_TIME_MONITORING=true
FEATURE_AUTO_SCALING=false

# External Service Integrations (Disabled for development)
SENTRY_DSN=""
DATADOG_API_KEY=""
NEW_RELIC_LICENSE_KEY=""

# Notification Settings (Console logging for development)
SLACK_WEBHOOK_URL=""
DISCORD_WEBHOOK_URL=""
EMAIL_SMTP_HOST=""
EMAIL_SMTP_PORT=1025  # MailHog for development
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASSWORD=""

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=""

# Development-specific Settings
DEV_AUTO_RELOAD=true
DEV_SHOW_STACKTRACES=true
DEV_ENABLE_PROFILER=true
DEV_MOCK_EXTERNAL_APIS=false

# PR Template for AI Agent (placeholders only)
PR_TEMPLATE="# {title}

**Branch**: {branch}
**Commit**: {commit_sha}
**Created**: {timestamp}

## Summary
{summary}

## Changes
{changes}

## Files Modified
{files_modified}

## Quality Assurance
{quality_assurance}

## Review Process
{review_process}" 